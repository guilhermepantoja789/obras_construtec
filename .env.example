APP_NAME=Construtec
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Manaus

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL externo (fora do Docker). Se o banco estiver no host, use host.docker.internal
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=diario_obras
DB_USERNAME=construtec
DB_PASSWORD=
# Testes usam diario_obras_test (ver phpunit.xml). Crie com: CREATE DATABASE diario_obras_test;

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true atrás do Cloudflare (HTTPS). false em http://127.0.0.1:18427
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker / Cloudflare
# Porta no host (só 127.0.0.1). O Tunnel ignora isto e usa http://nginx:80 na rede Docker.
APP_PORT=18427
RUN_MIGRATIONS=false
TRUSTED_PROXIES=*
CLOUDFLARE_TUNNEL_TOKEN=

# Landing institucional (placeholders — preencha com os dados reais)
CONSTRUTEC_PHONE=
CONSTRUTEC_WHATSAPP=
CONSTRUTEC_INSTAGRAM=
CONSTRUTEC_EMAIL=
CONSTRUTEC_CITY="Manaus, AM"
